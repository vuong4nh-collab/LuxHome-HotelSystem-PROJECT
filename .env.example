# Environment Variables — Hotel Management System
# Copy file này thành .env và chỉnh sửa theo môi trường của bạn

# ── Database ──────────────────────────────────
DB_ROOT_PASSWORD=rootpassword
DB_NAME=hotel_management
DB_USER=hotel_user
DB_PASSWORD=hotel123

# ── JWT ───────────────────────────────────────
JWT_SECRET=supersecretjwtkey2024hotelmanagement_changeme_in_production
JWT_EXPIRES_IN=30m

# ── Payment Webhook ───────────────────────────
# Set a unique, random secret shared only with the payment provider
PAYMENT_WEBHOOK_SECRET=replace_with_a_random_secret
ENABLE_PAYMENT_SANDBOX=false

# ── App ───────────────────────────────────────
NODE_ENV=development
PORT=5000
